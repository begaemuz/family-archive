# Ключ JavaScript API Яндекс Карт. Он не секретный: виден в коде страницы,
# а от чужого использования защищён ограничением по адресу сайта (HTTP Referer) в кабинете Яндекса.
VITE_YANDEX_MAPS_KEY=b0cad905-25cf-404a-a114-fb7d08605df0

# Ключ «Геосаджеста» — поиск места по названию (кладбище, храм, организация). Без него ищутся только адреса.
# Кабинет разработчика Яндекса → «Подключить API» → «API Геосаджеста». Тоже не секретный.
VITE_YANDEX_SUGGEST_KEY=
